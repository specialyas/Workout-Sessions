generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id         String   @id @default(uuid())
  exercise   String
  sets       Int
  reps       Int
  weight_kg  Float
  notes      String?
  logged_at  DateTime @default(now())
}
